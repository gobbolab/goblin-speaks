[Unit]
Description=Goblin Speaks tmux Launcher
Wants=network-online.target
After=network-online.target

[Service]
Type=forking
User=pi
WorkingDirectory=/home/pi/goblin-speaks
ExecStart=/usr/bin/tmux new-session -d -s goblin '/home/pi/goblin-speaks/launcher.sh'
ExecStop=/usr/bin/tmux kill-session -t goblin

[Install]
WantedBy=multi-user.target